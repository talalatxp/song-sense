<Window x:Class="SongSense.App.AiSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SongSense.App" Title="API de pago · Song Sense" Width="600" Height="780" MinWidth="360" MinHeight="480" SizeChanged="AdaptLayout" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" Icon="pack://application:,,,/SongSense;component/Assets/SongSense.ico">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVis"/><Style x:Key="FieldErrorText" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}"><Setter Property="Foreground" Value="{DynamicResource Error}"/><Setter Property="Margin" Value="0,8,0,0"/></Style></Window.Resources>
 <ScrollViewer x:Name="FormScroll" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="API de pago" FontFamily="Georgia" FontSize="{DynamicResource UiHeading24}" Margin="0,0,0,8"/>
  <StackPanel IsEnabled="{Binding CanManage}">
   <StackPanel x:Name="KeyValidationGroup" Margin="0,0,0,24">
    <TextBlock Text="Clave" FontWeight="SemiBold" FontSize="{DynamicResource UiHeading18}" Margin="0,0,0,8"/>
    <TextBlock Text="Clave OpenAI · nueva o de reemplazo"/>
    <PasswordBox x:Name="KeyInput" PasswordChanged="KeyChanged" Margin="0,8,0,0" AutomationProperties.Name="Clave OpenAI" AutomationProperties.HelpText="{Binding KeyError}" ui:UiState.FieldError="{Binding KeyError}"/>
    <TextBlock x:Name="KeyErrorText" Text="{Binding KeyError}" Style="{StaticResource FieldErrorText}"/>
    <TextBlock Text="{Binding KeyStatus}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
    <Button x:Name="DeleteKeyButton" Content="Eliminar clave y desactivar IA" Click="DeleteKey" IsEnabled="{Binding HasKey}" Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel>
   <StackPanel Margin="0,0,0,24">
    <StackPanel x:Name="ModelValidationGroup">
     <TextBlock Text="Modelo" FontWeight="SemiBold" FontSize="{DynamicResource UiHeading18}" Margin="0,0,0,8"/>
     <TextBlock x:Name="ModelLabel" Text="ID del modelo"/>
     <TextBox x:Name="ModelInput" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" AutomationProperties.Name="ID del modelo" AutomationProperties.HelpText="{Binding ModelError}" ui:UiState.FieldError="{Binding ModelError}"/>
     <TextBlock x:Name="ModelErrorText" Text="{Binding ModelError}" Style="{StaticResource FieldErrorText}"/>
    </StackPanel>
    <TextBlock Text="Usa el ID de la ficha oficial y comprueba su disponibilidad para tu proyecto." Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
    <Expander x:Name="ModelRequirements" Header="Requisitos del modelo" Margin="0,8,0,0"><StackPanel><TextBlock Text="Busca el ID en la ficha oficial del modelo. Ejemplo solo ilustrativo: modelo-ejemplo; no se rellena ni guarda automáticamente. Comprueba su disponibilidad para tu proyecto y su compatibilidad con Responses y salida estructurada. No se sustituye por otro modelo."/><Button Content="Documentación de modelos de OpenAI" Click="OpenModelDocumentation" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Margin="0,8,0,0"/></StackPanel></Expander>
   </StackPanel>
   <StackPanel x:Name="LimitValidationGroup" Margin="0,0,0,24">
    <TextBlock Text="Uso" FontWeight="SemiBold" FontSize="{DynamicResource UiHeading18}" Margin="0,0,0,8"/>
    <TextBlock x:Name="LimitLabel" Text="Límite diario · entero de 1 a 100"/>
    <TextBox x:Name="LimitInput" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" AutomationProperties.Name="Límite diario" AutomationProperties.HelpText="{Binding LimitError}" ui:UiState.FieldError="{Binding LimitError}"/>
    <TextBlock x:Name="LimitErrorText" Text="{Binding LimitError}" Style="{StaticResource FieldErrorText}"/>
    <TextBlock Text="{Binding CountLabel}" Margin="0,8,0,0" Foreground="{DynamicResource Muted}"/>
   </StackPanel>
   <StackPanel x:Name="NoticeValidationGroup" Margin="0,0,0,24">
    <TextBlock Text="Consentimiento" FontWeight="SemiBold" FontSize="{DynamicResource UiHeading18}" Margin="0,0,0,8"/>
    <TextBlock Text="Las pruebas y análisis se envían a OpenAI y pueden generar coste. El límite cuenta solicitudes, no euros. La prueba envía un texto fijo sin canción ni letra; analizar envía la letra confirmada. Cancelar una petición enviada no garantiza evitar su coste." Margin="0,0,0,8"/>
    <Border BorderBrush="{DynamicResource Error}"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding NoticeError}" Value=""><Setter Property="Padding" Value="0"/></DataTrigger><DataTrigger Binding="{Binding NoticeError}" Value=""><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers></Style></Border.Style><CheckBox x:Name="NoticeInput" IsChecked="{Binding NoticeAccepted, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.HelpText="{Binding NoticeError}"><TextBlock Text="He leído el aviso de envío de datos y coste"/></CheckBox></Border>
    <TextBlock x:Name="NoticeErrorText" Text="{Binding NoticeError}" Style="{StaticResource FieldErrorText}"/>
    <CheckBox IsChecked="{Binding AiEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,16,0,0"><TextBlock Text="Activar IA de API"/></CheckBox>
   </StackPanel>
   <Expander x:Name="DataRetention" Header="Datos y retención" Margin="0,0,0,24"><TextBlock Text="La clave se guarda cifrada para tu usuario de Windows. La clave nueva solo permanece en este campo hasta guardar o descartar. No hay reintentos automáticos. Se solicita store: false; esto no garantiza retención cero del proveedor. Letras y resultados se guardan en texto legible en la base local. Borrar caché conserva clave y contador."/></Expander>
  </StackPanel>
  <Border Background="{DynamicResource Surface}" Padding="12" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8"><StackPanel x:Name="ActionFooter">
   <ui:StatusNotice x:Name="DraftNotice" Message="{Binding FormInstruction}" Kind="{Binding FormNoticeKind}" Presentation="{Binding FormPresentation}"/>
   <TextBlock Text="{Binding FooterTestReason}" Style="{StaticResource OptionalText}" Margin="0,0,0,8"/>
   <ui:ActionPanel>
    <Button Content="Guardar" Click="SaveSettings" IsEnabled="{Binding CanManage}" Style="{StaticResource PrimaryButton}"/>
    <Button Content="Probar · de pago" Click="TestConnection" IsEnabled="{Binding CanTest}" Style="{StaticResource QuietButton}" ToolTip="{Binding TestReason}"/>
    <Button Content="Cancelar operación" Click="CancelOperation" IsEnabled="{Binding CanCancel}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}" Style="{StaticResource QuietButton}"/>
   </ui:ActionPanel>
   <ProgressBar x:Name="OperationProgress" IsIndeterminate="{Binding IsOperating}" Visibility="{Binding IsOperating, Converter={StaticResource BoolVis}}" Height="4" Margin="0,8,0,0" AutomationProperties.Name="{Binding OperationMessage}"/>
   <Expander Header="Configuración efectiva" Margin="0,16,0,0"><TextBlock Text="{Binding EffectiveConfiguration}"/></Expander>
   <Expander x:Name="OperationResult" Header="{Binding LastOperationTitle}" Visibility="{Binding HasOperationResult, Converter={StaticResource BoolVis}}" Margin="0,16,0,0"><ui:StatusNotice Message="{Binding LastOperationMessage}" Kind="{Binding LastOperationKind}" Presentation="{Binding ResultPresentation}"/></Expander>
   <TextBlock Text="{Binding Activity.LastActivity}" Margin="0,16,0,0" Foreground="{DynamicResource Muted}"/>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</Window>
