<Window x:Class="SongSense.App.AiSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SongSense.App"
 Title="API de pago · Song Sense" Width="600" Height="780" MinWidth="360" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" Icon="pack://application:,,,/SongSense;component/Assets/SongSense.ico">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="API de pago" FontFamily="Georgia" FontSize="24" Foreground="{DynamicResource Gold}"/><TextBlock Text="{Binding ChangeStatus}" FontSize="12" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <StackPanel x:Name="ActionFooter" DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{Binding EffectiveConfiguration}" FontSize="11"/>
   <TextBlock Text="{Binding TestReason}" FontSize="11" Margin="0,4,0,4"/>
   <WrapPanel>
    <Button Content="Guardar" Click="SaveSettings" IsEnabled="{Binding CanManage}" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="8,6" Margin="0,0,6,4"/>
    <Button Content="Probar · de pago" Click="TestConnection" IsEnabled="{Binding CanTest}" FontSize="12" Padding="8,6" Margin="0,0,6,4" ToolTip="{Binding TestReason}"/>
    <Button Content="Cancelar" Click="CancelOperation" IsEnabled="{Binding CanCancel}" FontSize="12" Padding="8,6" Margin="0,0,0,4"/>
   </WrapPanel>
   <ProgressBar IsIndeterminate="True" Height="3" IsEnabled="{Binding CanCancel}"/>
   <ui:StatusNotice Message="{Binding Message}" Kind="{Binding MessageKind}" IsCompact="True" FontSize="11" ToolTip="{Binding Message}"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding CanManage}" Margin="0,0,8,0">
   <TextBlock Text="Clave OpenAI · nueva o de reemplazo"/>
   <PasswordBox x:Name="KeyInput" PasswordChanged="KeyChanged" Margin="0,6,0,4" AutomationProperties.Name="Clave OpenAI"/>
   <TextBlock x:Name="KeyErrorText" Text="{Binding KeyError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource Gold}" FontSize="12"/>
   <TextBlock Text="{Binding KeyStatus}" FontSize="12" Foreground="{DynamicResource Muted}"/>
   <Button Content="Eliminar clave y desactivar IA" Click="DeleteKey" IsEnabled="{Binding HasKey}" HorizontalAlignment="Left" Margin="0,6,0,12"/>
   <TextBlock Text="ID del modelo"/><TextBox x:Name="ModelInput" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ID del modelo" Margin="0,6,0,4"/>
   <TextBlock x:Name="ModelErrorText" Text="{Binding ModelError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource Gold}" FontSize="12"/>
   <TextBlock Text="Busca el ID en la ficha oficial del modelo. Ejemplo solo ilustrativo: modelo-ejemplo; no se rellena ni guarda automáticamente. Comprueba su disponibilidad para tu proyecto y su compatibilidad con Responses y salida estructurada. No se sustituye por otro modelo." FontSize="12" Foreground="{DynamicResource Muted}"/>
   <Button Content="Documentación de modelos de OpenAI" Click="OpenModelDocumentation" HorizontalAlignment="Left" FontSize="12" Margin="0,6,0,12"/>
   <TextBlock Text="Límite diario · entero de 1 a 100"/><TextBox x:Name="LimitInput" Text="{Binding Limit, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Límite diario" Margin="0,6,0,4"/>
   <TextBlock x:Name="LimitErrorText" Text="{Binding LimitError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource Gold}" FontSize="12"/>
   <TextBlock Text="Las pruebas y análisis se envían a OpenAI y pueden generar coste. El límite cuenta solicitudes, no euros. La prueba envía un texto fijo sin canción ni letra; analizar envía la letra confirmada. Cancelar una petición enviada no garantiza evitar su coste." FontSize="13" Margin="0,10,0,8"/>
   <CheckBox x:Name="NoticeInput" IsChecked="{Binding NoticeAccepted, UpdateSourceTrigger=PropertyChanged}"><TextBlock Text="He leído el aviso de envío de datos y coste"/></CheckBox>
   <TextBlock x:Name="NoticeErrorText" Text="{Binding NoticeError}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource Gold}" FontSize="12"/>
   <CheckBox Content="Activar IA de API" IsChecked="{Binding AiEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,12"/>
   <Expander Header="Datos y almacenamiento"><TextBlock Text="La clave se guarda cifrada para tu usuario de Windows. La clave nueva solo permanece en este campo hasta guardar o descartar. No hay reintentos automáticos. Se solicita store: false; esto no garantiza retención cero del proveedor. Letras y resultados se guardan en texto legible en la base local. Borrar caché conserva clave y contador." FontSize="12"/></Expander>
   <TextBlock Text="{Binding CountLabel}" FontSize="12" Margin="0,12,0,6"/><TextBlock Text="{Binding Activity.LastActivity}" FontSize="12"/>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
