<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF uses the existing PerMonitorV2 manifest; no WinForms ApplicationConfiguration startup. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>SongSense</AssemblyName>
    <Version>0.14.0-preview.1</Version>
    <AssemblyVersion>0.14.0.0</AssemblyVersion>
    <FileVersion>0.14.0.1</FileVersion>
    <InformationalVersion>0.14.0-preview.1+ux13-14.20261022.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SongSense.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets/SongSense.png" />
    <Resource Include="Assets/SongSense.ico" />
    <ProjectReference Include="../SongSense.Core/SongSense.Core.csproj" />
    <ProjectReference Include="../SongSense.Infrastructure/SongSense.Infrastructure.csproj" />
  </ItemGroup>
</Project>
