<Window x:Class="SongSense.App.PreferencesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SongSense.App"
 SizeChanged="AdaptLayout" Title="Preferencias · Song Sense" Width="480" Height="600" MinWidth="360" MinHeight="480" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVis"/><ui:PointSizeToDipConverter x:Key="PointSizeToDip"/><Style x:Key="ActiveRetry" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PreferencesContent" Margin="24">
  <TextBlock Text="Preferencias" FontFamily="Georgia" FontSize="{DynamicResource UiHeading24}" Margin="0,0,0,16"/>
  <Expander x:Name="ReadingGroup" Header="Lectura" IsExpanded="True" Margin="0,0,0,24"><StackPanel>
  <TextBlock Text="Idioma de lectura · traducción y explicación" Margin="0,12,0,6"/>
  <ComboBox ItemsSource="{Binding AvailableLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding TargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeLanguage}" AutomationProperties.Name="Idioma de lectura · traducción y explicación" AutomationProperties.ItemStatus="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
  <TextBlock Text="{Binding LanguagePreferenceStatus}" FontSize="{DynamicResource UiInstructionFont}" Margin="0,8,0,0"/>
  <Button Content="Reintentar guardado de idioma" Command="{Binding RetryLanguageCommand}" Style="{StaticResource ActiveRetry}" Margin="0,8,0,0"/>
  <TextBlock Text="Tamaño del texto · 12 a 24 puntos" Margin="0,16,0,8"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Slider Margin="0,0,12,0" x:Name="ReadingSize" Minimum="12" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Owner.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" AutomationProperties.Name="Tamaño de texto, de 12 a 24 puntos"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Owner.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0} pt}" FontSize="{DynamicResource UiInstructionFont}"/></Grid><Grid><TextBlock Text="12 pt"/><TextBlock Text="24 pt" HorizontalAlignment="Right"/></Grid><TextBlock Text="Ejemplo de lectura" Foreground="{DynamicResource Muted}" Margin="0,16,0,8"/><TextBlock x:Name="ReadingSample" Text="Abro una ventana y dejo entrar la luz." FontFamily="Georgia" FontSize="{Binding Owner.ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PointSizeToDip}}"/></StackPanel></Expander>
<Expander x:Name="WindowGroup" Header="Ventana y seguimiento" IsExpanded="True" Margin="0,0,0,24"><StackPanel><CheckBox x:Name="TopmostToggle" Content="Siempre encima" IsChecked="{Binding Owner.Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" Margin="0,16,0,12"/>
  <CheckBox Content="Seguir canción" IsChecked="{Binding AutomaticUpdatesEnabled}" ToolTip="Sigue la canción y recupera letra/caché. No consulta IA."/>
  <TextBlock Text="{Binding AutomaticMessage}" FontSize="{DynamicResource UiInstructionFont}" Margin="0,8,0,8"/>
  <Button Content="Actualizar letra" Command="{Binding RetryAutomaticCommand}" HorizontalAlignment="Left"/>
  <TextBlock Text="{Binding Owner.PreferenceMessage, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource OptionalText}" Margin="0,12,0,0"/>
  <TextBlock Text="Al cerrar" FontWeight="SemiBold" Margin="0,16,0,8"/>
  <CheckBox Content="Mantener en bandeja al cerrar" IsChecked="{Binding Owner.KeepInTray, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
  <TextBlock Text="Marcado: X y Alt+F4 ocultan la ventana y mantienen el seguimiento. Abre de nuevo con el icono de bandeja; su menú permite Salir. Desmarcado: X y Alt+F4 terminan la aplicación. Salir siempre cancela las operaciones; una solicitud ya enviada puede haber consumido tokens." FontSize="{DynamicResource UiInstructionFont}" Margin="0,8,0,12"/>
  </StackPanel></Expander><Expander x:Name="LocalDataGroup" Header="Datos locales" Margin="0,0,0,24"><StackPanel>
   <TextBlock Text="Caché local: letras manuales o seleccionadas y análisis. Caduca a los 30 días; conserva hasta 200 canciones por uso reciente. Las ausencias caducan en una hora. No es una copia de seguridad permanente." FontSize="{DynamicResource UiInstructionFont}" Margin="0,8,0,8"/>
   <TextBlock Text="Eliminar datos guardados" FontWeight="SemiBold" Margin="0,16,0,8"/><TextBlock Text="Borrar conserva preferencias, clave y contador. Requiere confirmación." Margin="0,0,0,12"/><Button Style="{StaticResource DangerButton}" x:Name="DeleteSongButton" Content="Eliminar contenido de esta canción" Click="DeleteSong" IsEnabled="{Binding CanDeleteSong}" HorizontalContentAlignment="Left" Margin="0,0,0,4"/>
   <TextBlock Text="Elimina la letra y los análisis guardados solo de la canción mostrada." FontSize="{DynamicResource UiSecondaryFont}" Margin="0,0,0,12"/>
   <Button Style="{StaticResource DangerButton}" x:Name="DeleteAllButton" Content="Eliminar toda la caché" Click="DeleteAll" IsEnabled="{Binding CanDeleteCache}" HorizontalContentAlignment="Left"/>
   <TextBlock Text="{Binding CacheMessage}" FontSize="{DynamicResource UiInstructionFont}" Margin="0,8,0,0"/>
  </StackPanel></Expander>
  <TextBlock Text="{Binding StorageMessage}" Style="{StaticResource OptionalText}"/><Button Content="Reintentar almacenamiento" Command="{Binding RetryStorageCommand}" Style="{StaticResource ActiveRetry}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
  <Expander x:Name="AdvancedGroup" Header="Avanzado" Margin="0,12,0,0"><StackPanel><TextBlock Text="Usa estas herramientas si falla el almacenamiento. La recuperación conserva una copia local y requiere confirmación." FontSize="{DynamicResource UiInstructionFont}"/>
  <Button Content="Ver diagnóstico" Click="Diagnostic" HorizontalAlignment="Left" Margin="0,16,0,8"/>
  <Button Content="Recuperar base local" Click="Recover" IsEnabled="{Binding CanRecoverStorage}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
  </StackPanel></Expander><Button Content="Salir de Song Sense" Click="Exit" HorizontalAlignment="Left"/>
 </StackPanel></ScrollViewer>
</Window>
