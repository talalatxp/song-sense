<Application x:Class="SongSense.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Muted" Color="#B2B7C9" />
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#F3F4FA" />
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="FontSize" Value="16" />
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#B2B7C9" />
   <Setter Property="FontSize" Value="16" />
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Padding="16,12" Margin="0,0,6,0" Background="#171B29" CornerRadius="8,8,0,0">
      <ContentPresenter ContentSource="Header" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#292C42" /><Setter Property="Foreground" Value="#C8BDFF" /></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#30354B" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8BDFF" /><Setter TargetName="TabBorder" Property="BorderThickness" Value="1" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>
