<Window x:Class="SongSense.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SongSense" Width="480" Height="720" MinWidth="360" MinHeight="480"
 Background="#10131E" Foreground="#F3F4FA" FontFamily="Segoe UI"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
   <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="SongSense" FontSize="26" FontWeight="SemiBold" />
   <TextBlock Text="Entiende lo que escuchas" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
  </StackPanel>
  <Border Grid.Row="1" Background="#1B2030" CornerRadius="12" Padding="16" Margin="0,0,0,20">
   <StackPanel>
    <TextBlock Text="CANCIÓN ACTUAL" FontSize="11" Foreground="{StaticResource Muted}" />
    <TextBlock Text="{Binding TrackTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,4,0,12" />
    <TextBlock Text="{Binding Album}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" />
    <TextBlock Text="{Binding Duration}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
    <Border HorizontalAlignment="Left" Background="#292C42" CornerRadius="6" Padding="10,5">
     <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#C8BDFF" />
    </Border>
   </StackPanel>
  </Border>
  <WrapPanel Grid.Row="2" Margin="0,0,0,12">
   <Button Content="Buscar letra" Command="{Binding SearchLyricsCommand}" AutomationProperties.AutomationId="SearchLyrics" Padding="14,7" Margin="0,0,8,0" />
   <Button Content="Cancelar" Command="{Binding CancelLyricsCommand}" AutomationProperties.AutomationId="CancelLyrics" Padding="14,7" />
  </WrapPanel>
  <TabControl Grid.Row="3" Background="#171B29" BorderThickness="0" Padding="0">
   <TabItem Header="Traducción" AutomationProperties.AutomationId="TranslationTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="20,28">
      <TextBlock Text="Letra original" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding DetectionMessage}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
      <TextBlock Text="{Binding LyricsMessage}" FontSize="14" Foreground="#C8BDFF" Margin="0,12,0,0" />
      <TextBlock Text="{Binding OriginalLyrics}" Margin="0,16,0,0" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Significado" AutomationProperties.AutomationId="MeaningTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="20,28">
      <TextBlock Text="Más allá de las palabras" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Aquí aparecerán el resumen, los temas y las posibles interpretaciones de la canción." Foreground="{StaticResource Muted}" Margin="0,12,0,0" />
      <TextBlock Text="Todavía no se ha analizado ninguna letra." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,24,0,0" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="4" Margin="0,14,0,0">
   <TextBlock Text="{Binding StorageMessage}" Foreground="{StaticResource Muted}" FontSize="12" />
   <Button Content="Reintentar almacenamiento" Command="{Binding RetryStorageCommand}" HorizontalAlignment="Left" Padding="10,6" Margin="0,8,0,0">
    <Button.Style><Style TargetType="Button">
     <Setter Property="Visibility" Value="Collapsed" />
     <Style.Triggers><DataTrigger Binding="{Binding StorageError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
    </Style></Button.Style>
   </Button>
  </StackPanel>
 </Grid>
</Window>
