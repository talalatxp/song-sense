<Window x:Class="SongSense.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Song Sense" Width="860" Height="780" MinWidth="360" MinHeight="480"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI"
 Icon="pack://application:,,,/SongSense;component/Assets/SongSense.ico" WindowStartupLocation="CenterScreen" SizeChanged="AdaptReadingLayout">
 <Window.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource Outline}"/><Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBorder" Background="Transparent" Padding="0,4" BorderBrush="Transparent" BorderThickness="1"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="›" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter x:Name="ContentSite" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ContextMenu"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="10" Padding="6"><ItemsPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBorder" Property="Background" Value="#383024"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{StaticResource Outline}" Margin="8,6"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <Border x:Name="ComboBorder" Background="{StaticResource Raised}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="8"/>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="10,7"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="12,7,30,7" IsHitTestVisible="False" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
     <Border MinWidth="{TemplateBinding ActualWidth}" Background="{StaticResource Raised}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0"><ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
    </Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="LanguageItem" Background="Transparent" CornerRadius="5" Padding="10,8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="LanguageItem" Property="Background" Value="#383024"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource Outline}" CornerRadius="4" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   </Track>
  </ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <ScrollViewer x:Name="WindowViewport" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
  <Grid x:Name="RootGrid" Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="HeaderBlock" Margin="0,0,0,24">
    <Button DockPanel.Dock="Right" Content="Cuenta" Click="OpenConnection" Style="{StaticResource QuietButton}" VerticalAlignment="Center" ToolTip="Cuenta y consumo"/>
    <TextBlock FontFamily="Georgia" FontSize="25" Foreground="{StaticResource Gold}" VerticalAlignment="Center" TextWrapping="NoWrap" AutomationProperties.Name="Song Sense"><Run Text="&#x1D11E;" FontFamily="Segoe UI Symbol"/><Run Text="ong "/><Run Text="&#x1D11E;" FontFamily="Segoe UI Symbol"/><Run Text="ense"/></TextBlock>
   </DockPanel>
   <Border x:Name="SongCard" Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="16" Padding="22" Margin="0,0,0,20" BorderBrush="{StaticResource Outline}" BorderThickness="1">
    <StackPanel>
     <DockPanel Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayStatus}" Foreground="{StaticResource Gold}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
      <TextBlock Text="AHORA SUENA" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="TrackTitleText" Text="{Binding TrackTitle}" ToolTip="{Binding TrackTitle}" FontFamily="Georgia" FontSize="32" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     <DockPanel x:Name="TrackMetadata" Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Foreground="{StaticResource Muted}" FontSize="11"/>
      <TextBlock Text="{Binding Album}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <WrapPanel x:Name="ActionsPanel" Margin="0,20,0,0">
      <Button Content="Traducir y explicar" Command="{Binding GenerateInsightCommand}" AutomationProperties.AutomationId="GenerateInsight" Margin="0,0,8,0">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowGenerate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="Buscar letra" Command="{Binding SearchLyricsCommand}" AutomationProperties.AutomationId="SearchLyrics" Margin="0,0,8,0">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowSearch}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="Cancelar" Command="{Binding CancelInsightCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="Cancelar búsqueda" Command="{Binding CancelLyricsCommand}" AutomationProperties.AutomationId="CancelLyrics" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="Más ···" Click="OpenSongMenu" Style="{StaticResource QuietButton}" AutomationProperties.Name="Más acciones de la canción">
       <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Buscar letra" Command="{Binding SearchLyricsCommand}"/>
        <MenuItem Header="Cambiar letra…" Click="ChangeLyrics" IsEnabled="{Binding CanEditLyrics}"/>
        <MenuItem Header="Usar letra guardada" Command="{Binding ConfirmCachedLyricsCommand}"/>
        <Separator/>
        <MenuItem Header="Regenerar análisis" Command="{Binding RegenerateCommand}"/>
        <Separator/><MenuItem Header="Borrar esta canción" Command="{Binding DeleteSongCommand}"/>
       </ContextMenu></Button.ContextMenu>
      </Button>
     </WrapPanel>
     <TextBlock Text="{Binding DisplayNotice}" Style="{StaticResource OptionalText}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <TabControl x:Name="ReadingTabs" Grid.Row="2">
    <TabItem Header="Letra y traducción" AutomationProperties.AutomationId="TranslationTab">
     <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="24" BorderBrush="{StaticResource Outline}" BorderThickness="1">
      <ScrollViewer x:Name="TranslationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Lectura por estrofas"><StackPanel>
       <TextBlock Text="{Binding ReadingHint}" Foreground="{StaticResource Muted}" FontSize="13"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding HasInsight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <ItemsControl ItemsSource="{Binding ReadingBlocks}"><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel Margin="0,14,0,20">
         <TextBlock Text="{Binding Original}" FontFamily="Georgia" Foreground="{StaticResource Muted}" LineHeight="30" FontSize="{Binding ReadingTextSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
         <TextBlock Text="{Binding Translation}" Margin="0,12,0,0" LineHeight="30" FontSize="{Binding ReadingTextSize, RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding HasTranslation}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>
     </Border>
    </TabItem>
    <TabItem Header="Significado" AutomationProperties.AutomationId="MeaningTab">
     <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="24" BorderBrush="{StaticResource Outline}" BorderThickness="1">
      <ScrollViewer x:Name="MeaningScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <TextBlock Text="¿Qué cuenta esta canción?" FontFamily="Georgia" FontSize="24" Foreground="{StaticResource Gold}" Margin="0,4,0,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding HasInsight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Text="Pulsa Traducir y explicar para descubrirlo." Foreground="{StaticResource Muted}" FontSize="14"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding HasInsight}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasInsight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBlock Text="{Binding InsightSummary}" LineHeight="30" FontSize="{Binding ReadingTextSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,20"/>
        <TextBlock Text="{Binding InsightThemes}" Foreground="{StaticResource Gold}" FontSize="14" Margin="0,0,0,20"/>
        <Expander Header="Metáforas" Margin="0,0,0,12"><TextBlock Text="{Binding InsightMetaphors}" FontSize="{Binding ReadingTextSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,12,0,12"/></Expander>
        <Expander Header="Otras lecturas" Margin="0,0,0,12"><TextBlock Text="{Binding InsightAlternatives}" FontSize="{Binding ReadingTextSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,12,0,12"/></Expander>
        <Expander Header="Matices" Margin="0,0,0,12"><TextBlock Text="{Binding InsightWarnings}" FontSize="14" Margin="0,12,0,12"/></Expander>
        <TextBlock Text="Interpretación de IA" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
       </StackPanel>
      </StackPanel></ScrollViewer>
     </Border>
    </TabItem>
   </TabControl>
   <StackPanel Grid.Row="3" Margin="0,16,0,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding CompactUsage}" ToolTip="{Binding UsageMessage}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Top" Margin="12,3,0,0" AutomationProperties.Name="Consumo de la consulta de IA"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=OptionsPanel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Expander x:Name="OptionsPanel" Header="Ajustes" Expanded="ReflowOptions" Collapsed="ReflowOptions">
      <StackPanel Margin="0,16,0,0">
       <WrapPanel Margin="0,0,0,16">
        <TextBlock Text="Idioma" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ComboBox ItemsSource="{Binding AvailableLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding TargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeLanguage}" Width="180" Padding="10,7" FontSize="13" ToolTip="Traducción y explicaciones" AutomationProperties.Name="Idioma de traducción y explicaciones"/>
       </WrapPanel>
       <TextBlock Text="{Binding LanguageMessage}" Style="{StaticResource OptionalText}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,0,0,12"/>
       <Button Content="Reintentar guardado" Command="{Binding RetryLanguageCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></Button.Style></Button>
       <TextBlock Text="{Binding CompactUsage}" Style="{StaticResource OptionalText}" ToolTip="{Binding UsageMessage}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
       <WrapPanel>
        <CheckBox x:Name="AlwaysOnTop" Content="Siempre encima" Foreground="{StaticResource Ink}" Margin="0,0,16,12" Checked="ToggleTopmost" Unchecked="ToggleTopmost"/>
        <CheckBox Content="Seguir canción" Foreground="{StaticResource Ink}" IsChecked="{Binding AutomaticUpdatesEnabled}" Margin="0,0,0,12" ToolTip="Actualiza la canción y la letra. No consulta IA."/>
       </WrapPanel>
       <WrapPanel Margin="0,4,0,12"><TextBlock Text="Texto" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,12,0" VerticalAlignment="Center"/><Slider x:Name="TextSizeSlider" Minimum="12" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Width="130" Value="{Binding ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" AutomationProperties.Name="Tamaño de texto, de 12 a 24 puntos"/><TextBlock Text="{Binding ReadingFontSize, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0} pt}" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0"/></WrapPanel>
       <WrapPanel><Button Content="Actualizar letra" Command="{Binding RetryAutomaticCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/><Button Content="Borrar caché" Command="{Binding ClearCacheCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8"/><Button Content="Salir" Click="ExitApplication" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
       <Expander Header="Detalles" Margin="0,8,0,0"><StackPanel Margin="0,12,0,0">
        <TextBlock Text="{Binding InsightMessage}" Style="{StaticResource OptionalText}" FontSize="12" Foreground="{StaticResource Gold}" AutomationProperties.Name="Diagnóstico de la consulta"/>
        <TextBlock Text="{Binding LyricsMessage}" Style="{StaticResource OptionalText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding CacheMessage}" Style="{StaticResource OptionalText}" FontSize="12" Foreground="{StaticResource Muted}"/>
        <TextBlock Text="{Binding LyricsSource}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding UsageMessage}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding AiConfigurationStatus}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding AutomaticMessage}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding StorageMessage}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        <TextBlock x:Name="PreferenceStatus" FontSize="12" Foreground="{StaticResource Gold}"/>
       </StackPanel></Expander>
       <Button Content="Recuperar base local" Click="RecoverStorage" HorizontalAlignment="Left" Margin="0,8,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanRecoverStorage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Content="Reintentar almacenamiento" Command="{Binding RetryStorageCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding StorageError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      </StackPanel>
     </Expander>
    </DockPanel>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</Window>
