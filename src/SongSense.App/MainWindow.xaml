<Window x:Class="SongSense.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SongSense.App"
 Title="Song Sense" Width="860" Height="780" MinWidth="360" MinHeight="480" SizeChanged="AdaptReadingLayout"
 Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" Icon="pack://application:,,,/SongSense;component/Assets/SongSense.ico" WindowStartupLocation="CenterScreen">
 <Grid x:Name="RootGrid" Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="BrandText" Text="&#x1D11E;ong &#x1D11E;ense" FontFamily="Georgia" FontSize="22" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" Margin="0,0,18,0"/>
   <StackPanel Grid.Column="1">
    <TextBlock Text="{Binding TrackContextLabel}" FontSize="9" Foreground="{DynamicResource Muted}" AutomationProperties.AutomationId="TrackContextLabel"/>
    <TextBlock x:Name="TrackTitleText" Text="{Binding TrackTitle}" ToolTip="{Binding TrackTitle}" FontFamily="Georgia" FontSize="20" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Cuenta" Click="OpenConnection" Style="{StaticResource QuietButton}" Padding="8,5" FontSize="11" Margin="4,0,4,0"/>
    <Button Content="Ajustes" Click="OpenPreferences" Style="{StaticResource QuietButton}" Padding="8,5" FontSize="11"/>
   </StackPanel>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,0,0,4">
   <TextBlock Text="{Binding PlaybackStatus}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" AutomationProperties.AutomationId="PlaybackStatus"/>
   <TextBlock Text="{Binding TrackingStatus}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" AutomationProperties.AutomationId="TrackingStatus"/>
   <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="{DynamicResource Gold}"/>
  </WrapPanel>
  <StackPanel Grid.Row="2" Margin="0,0,0,4">
   <Button x:Name="AiDecisionButton" Click="ReviewAiDecision" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="6,3" FontSize="13" Margin="0,0,0,3" MaxWidth="{Binding ActualWidth, ElementName=RootGrid}" AutomationProperties.AutomationId="AiDecision" AutomationProperties.Name="{Binding AiDecisionLabel}" AutomationProperties.HelpText="Configuración para la próxima consulta. Abrir Cuenta para revisarla; no genera análisis.">
    <Button.Template><ControlTemplate TargetType="Button">
     <Border x:Name="DecisionBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DecisionBorder" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Button.Template>
    <TextBlock Text="{Binding AiDecisionLabel}" FontSize="13" TextWrapping="Wrap"/>
   </Button>
  <DockPanel>
   <TextBlock x:Name="UsageBadge" DockPanel.Dock="Right" Text="{Binding CompactUsage}" ToolTip="{Binding UsageMessage}" TextWrapping="Wrap" MaxWidth="220" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" AutomationProperties.Name="Consumo de la consulta de IA"/>
   <StackPanel Orientation="Horizontal">
    <Button Content="{Binding PrimaryActionLabel}" Click="ExecutePrimaryAction" IsEnabled="{Binding CanPrimaryAction}" AutomationProperties.AutomationId="PrimaryAction" Padding="10,6" FontSize="12" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowPrimaryAction}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button Content="Reanudar" Command="{Binding ResumeTrackingCommand}" ToolTip="Reanudar seguimiento" AutomationProperties.Name="Reanudar seguimiento" AutomationProperties.AutomationId="ResumeTracking" Padding="10,6" FontSize="12" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding CanResumeTracking}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button x:Name="ApplicationMenuButton" Content="⋯" Click="OpenSongMenu" Style="{StaticResource QuietButton}" Padding="10,4" AutomationProperties.Name="Menú de Song Sense y acciones de la canción">
     <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Detalles de la canción…" Click="OpenSongDetails"/>
      <MenuItem Header="Buscar letra" Command="{Binding SearchLyricsCommand}"/>
      <MenuItem Header="Cambiar letra…" Click="ChangeLyrics" IsEnabled="{Binding CanEditLyrics}"/>
      <MenuItem Header="Usar letra guardada" Command="{Binding ConfirmCachedLyricsCommand}"/>
      <MenuItem Header="Regenerar análisis" Command="{Binding RegenerateCommand}"/>
      <MenuItem Header="Ver diagnóstico" Click="ToggleDiagnostic"/>
      <Separator/><MenuItem Header="Acerca de Song Sense" Click="ShowAbout"/><MenuItem Header="Salir de Song Sense" Click="ExitApplication"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
   </StackPanel>
  </DockPanel>
  </StackPanel>
  <DockPanel Grid.Row="3" Margin="0,0,0,4">
   <Button DockPanel.Dock="Right" Content="Diagnóstico" Click="ToggleDiagnostic" Style="{StaticResource QuietButton}" Padding="6,2" FontSize="10" Margin="8,0,0,0"/>
   <ui:StatusNotice AnnouncementScope="{Binding Preparation.Cause}" Message="{Binding DisplayNotice}" Kind="{Binding DisplayNoticeKind}" IsCompact="True" ToolTip="{Binding DisplayNotice}" FontSize="11" VerticalAlignment="Center"/>
  </DockPanel>
   <Grid Grid.Row="4">
   <TabControl x:Name="ReadingTabs">
    <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Padding" Value="3,6"/><Setter Property="FontSize" Value="11"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/></DataTrigger></Style.Triggers></Style></TabControl.Resources>
    <TabItem Header="Letra y traducción" AutomationProperties.AutomationId="TranslationTab">
     <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
      <DockPanel>
       <ComboBox x:Name="ReadingMode" DockPanel.Dock="Top" HorizontalAlignment="Left" FontSize="11" Padding="6,2" Margin="0,0,0,2" SelectionChanged="ChangeReadingMode" AutomationProperties.Name="Modo de lectura">
        <ComboBoxItem Content="Original"/><ComboBoxItem Content="Traducción"/><ComboBoxItem Content="Ambos"/>
       </ComboBox>
       <ui:ReadingDocument x:Name="TranslationScroll" AutomationProperties.Name="Letra y traducción · documento de solo lectura"/>
      </DockPanel>
     </Border>
    </TabItem>
    <TabItem Header="Significado" AutomationProperties.AutomationId="MeaningTab">
     <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="10" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
      <ui:ReadingDocument x:Name="MeaningScroll" AutomationProperties.Name="Significado · documento de solo lectura"/>
     </Border>
    </TabItem>
   </TabControl>
   <ComboBox x:Name="ReadingLanguage" ItemsSource="{Binding AvailableLanguages}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding TargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeLanguage}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="98" Padding="6,4" FontSize="11" AutomationProperties.Name="Idioma de lectura y explicaciones"/>
   </Grid>
 <TextBlock x:Name="UsageFooter" Grid.Row="5" Text="{Binding CompactUsage}" ToolTip="{Binding UsageMessage}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" AutomationProperties.Name="Consumo de la consulta de IA"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</Grid></Window>
