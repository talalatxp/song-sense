  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="ToggleBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" Padding="4">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="{DynamicResource UiIconColumn}" Height="{DynamicResource UiFirstLineHeight}" VerticalAlignment="Top" IsHitTestVisible="False">
      <Path x:Name="Arrow" Data="M3,1 L9,6 L3,11" Width="{DynamicResource UiChevronSize}" Height="{DynamicResource UiChevronSize}" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="{DynamicResource UiIconStroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path>
     </Grid>
     <ContentPresenter x:Name="HeaderText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"><ContentPresenter.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap" TextBlock.LineHeight="{DynamicResource UiFirstLineHeight}"/></DataTemplate></ContentPresenter.Resources></ContentPresenter>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Focus}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SelectionSurface}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Expander">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontSize" Value="{DynamicResource UiInstructionFont}"/>
  <Setter Property="Padding" Value="{DynamicResource UiExpanderContentInset}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel><ToggleButton x:Name="HeaderSite" Foreground="{TemplateBinding Foreground}" Style="{StaticResource ExpanderToggle}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" FontSize="{TemplateBinding FontSize}" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
    <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" Visibility="Collapsed"/>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="local:UiLayout.IsCompact" Value="True"><Setter Property="Padding" Value="16,12,0,0"/></Trigger>
   <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"><Setter Property="Padding" Value="0,12,0,0"/></DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="NoticeDetailExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="{DynamicResource UiSecondaryFont}"/><Setter Property="Padding" Value="0,12,0,0"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
 <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate>
     <Border Background="Transparent" />
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ScrollThumb" TargetType="Thumb">
  <Setter Property="Background" Value="{DynamicResource ControlBorder}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2" />
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Focus}" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
       <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Gold}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="14" />
  <Setter Property="MinWidth" Value="0" />
  <Setter Property="Background" Value="{DynamicResource Canvas}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Grid Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton>
        <RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
       </Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb x:Name="ScrollGrip" Style="{StaticResource ScrollThumb}" MinHeight="24" />
       </Track.Thumb>
       <Track.IncreaseRepeatButton>
        <RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
       </Track.IncreaseRepeatButton>
      </Track>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
       <Setter Property="Width" Value="Auto" />
       <Setter Property="Height" Value="14" />
       <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
       <Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand" />
       <Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand" />
       <Setter TargetName="ScrollGrip" Property="MinHeight" Value="0" />
       <Setter TargetName="ScrollGrip" Property="MinWidth" Value="24" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Visibility" Value="Hidden" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="Height" Value="14" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="SliderThumb" TargetType="Thumb">
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="SliderThumbBody" Background="{DynamicResource Gold}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Width="18" Height="24" CornerRadius="4" />
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="SliderThumbBody" Property="BorderBrush" Value="{DynamicResource Focus}" />
       <Setter TargetName="SliderThumbBody" Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
       <Setter TargetName="SliderThumbBody" Property="BorderThickness" Value="3" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="SliderThumbBody" Property="Background" Value="{DynamicResource DisabledText}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="Slider">
  <Setter Property="MinHeight" Value="32" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid Background="Transparent" Margin="4">
      <Border Height="4" Background="{DynamicResource ControlBorder}" VerticalAlignment="Center" />
      <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
       <Track.DecreaseRepeatButton>
        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ScrollPageButton}" />
       </Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb Style="{StaticResource SliderThumb}" />
       </Track.Thumb>
       <Track.IncreaseRepeatButton>
        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollPageButton}" />
       </Track.IncreaseRepeatButton>
      </Track>
      <Border x:Name="SliderFocus" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False" />
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="SliderFocus" Property="Visibility" Value="Visible" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ContextMenu">
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContextMenu">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4">
      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="BorderThickness" Value="2" />
  <Setter Property="Padding" Value="10,8" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="MenuItem">
     <Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="20" />
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" VerticalAlignment="Center" />
        <Path x:Name="MenuCheck" Data="M 1,6 L 5,10 L 13,1" Width="13" Height="11" Stretch="Fill" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Collapsed" VerticalAlignment="Center" />
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource UiInstructionFont}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Width="4" Height="8" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" />
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
       <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="4" CornerRadius="6">
        <ScrollViewer CanContentScroll="True" MaxHeight="400" VerticalScrollBarVisibility="Auto">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="HasItems" Value="True">
       <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed" />
       <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Role" Value="TopLevelHeader">
       <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="IsHighlighted" Value="True">
    <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
   </Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
   </Trigger>
   <Trigger Property="IsEnabled" Value="False">
    <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate>
     <Border Height="1" Background="{DynamicResource Outline}" Margin="8,6" />
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="local:StatusNotice">
  <Setter Property="Foreground" Value="{DynamicResource Information}"/><Setter Property="Focusable" Value="False"/>
  <Setter Property="FontSize" Value="{DynamicResource UiInstructionFont}"/><Setter Property="Padding" Value="{DynamicResource NoticeInset}"/><Setter Property="Margin" Value="{DynamicResource NoticeGap}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:StatusNotice">
   <Border x:Name="NoticeFrame" Background="{DynamicResource Surface}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="3,0,0,0" CornerRadius="4" Padding="{TemplateBinding Padding}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid x:Name="NoticeIconColumn" Width="{DynamicResource UiIconColumn}" Height="{DynamicResource UiFirstLineHeight}" VerticalAlignment="Top" IsHitTestVisible="False">
      <Path x:Name="Symbol" Width="{DynamicResource UiIconSize}" Height="{DynamicResource UiIconSize}" Stretch="Uniform" Data="{StaticResource NoticeInformation}" Stroke="{TemplateBinding Foreground}" StrokeThickness="{DynamicResource UiIconStroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Focusable="False"/>
     </Grid>
     <StackPanel x:Name="NoticeBody" Grid.Column="1" Margin="8,0,0,0">
      <TextBlock x:Name="NoticeText" FontSize="{TemplateBinding FontSize}" LineHeight="{DynamicResource UiFirstLineHeight}" Foreground="{DynamicResource Ink}" Text="{TemplateBinding DisplayText}" TextWrapping="Wrap" TextTrimming="None"/>
      <TextBlock x:Name="NoticeExplanation" Style="{StaticResource OptionalText}" Text="{TemplateBinding Explanation}" FontSize="{TemplateBinding FontSize}" LineHeight="{DynamicResource UiFirstLineHeight}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
      <Expander x:Name="NoticeDetail" Style="{StaticResource NoticeDetailExpander}" Header="Ver detalle" Visibility="Collapsed">
       <TextBox Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Detalle completo del aviso"/>
      </Expander>
      <ContentPresenter x:Name="NoticeAction" HorizontalAlignment="Left" Content="{TemplateBinding ActionContent}" Margin="0,12,0,0" Visibility="Collapsed"/>
     </StackPanel>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Presentation" Value="Routine">
     <Setter TargetName="NoticeFrame" Property="Background" Value="Transparent"/><Setter TargetName="NoticeFrame" Property="BorderThickness" Value="0"/><Setter TargetName="NoticeFrame" Property="Padding" Value="0"/>
     <Setter TargetName="NoticeIconColumn" Property="Visibility" Value="Collapsed"/><Setter TargetName="NoticeBody" Property="Margin" Value="0"/>
     <Setter TargetName="NoticeText" Property="Foreground" Value="{DynamicResource Muted}"/><Setter TargetName="NoticeText" Property="FontSize" Value="{DynamicResource UiSecondaryFont}"/>
    </Trigger>
    <Trigger Property="Presentation" Value="Contextual">
     <Setter TargetName="NoticeFrame" Property="Background" Value="Transparent"/><Setter TargetName="NoticeFrame" Property="BorderThickness" Value="0"/><Setter TargetName="NoticeFrame" Property="Padding" Value="0"/>
     <Setter TargetName="NoticeIconColumn" Property="Visibility" Value="Collapsed"/><Setter TargetName="NoticeBody" Property="Margin" Value="0"/>
    </Trigger>
    <Trigger Property="HasDetails" Value="True"><Setter TargetName="NoticeDetail" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="HasAction" Value="True"><Setter TargetName="NoticeAction" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="Kind" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Success}"/><Setter TargetName="Symbol" Property="Data" Value="{StaticResource NoticeSuccess}"/></Trigger>
    <Trigger Property="Kind" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Warning}"/><Setter TargetName="Symbol" Property="Data" Value="{StaticResource NoticeWarning}"/></Trigger>
    <Trigger Property="Kind" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Error}"/><Setter TargetName="Symbol" Property="Data" Value="{StaticResource NoticeError}"/></Trigger>
    <Trigger Property="Kind" Value="Progress"><Setter Property="Foreground" Value="{DynamicResource Progress}"/><Setter TargetName="Symbol" Property="Data" Value="{StaticResource NoticeProgress}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="Message" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
