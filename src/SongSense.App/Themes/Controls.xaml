 <Style TargetType="ComboBox" BasedOn="{StaticResource InputBase}">
  <Setter Property="Padding" Value="10,8" />
  <Setter Property="MinHeight" Value="{DynamicResource UiControlMinimum}" />
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Border Background="Transparent">
          <Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="{DynamicResource Ink}" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" />
         </Border>
        </ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Margin="10,6,32,6" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False"><ContentPresenter.Resources><DataTemplate DataType="{x:Type sys:String}"><TextBlock Text="{Binding}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextWrapping="Wrap"/></DataTemplate></ContentPresenter.Resources></ContentPresenter>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
