<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SongSense.App" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
 <sys:Double x:Key="UiControlFont">14</sys:Double>
 <sys:Double x:Key="UiInstructionFont">13</sys:Double>
 <sys:Double x:Key="UiSecondaryFont">12</sys:Double>
 <sys:Double x:Key="UiEditorMinHeight">0</sys:Double>
 <sys:Double x:Key="UiMainMinimumHeight">0</sys:Double>
 <sys:Double x:Key="UiHeading18">18</sys:Double><sys:Double x:Key="UiHeading20">20</sys:Double><sys:Double x:Key="UiHeading22">22</sys:Double><sys:Double x:Key="UiHeading24">24</sys:Double><sys:Double x:Key="UiHeading26">26</sys:Double>
 <ControlTemplate x:Key="ValidationAdornment">
  <DockPanel LastChildFill="True">
   <Border DockPanel.Dock="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Error}" BorderThickness="2" Margin="4,0,0,0" Padding="4,0">
    <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Error}" ToolTip="Revisa el valor del campo" />
   </Border>
   <AdornedElementPlaceholder />
  </DockPanel>
 </ControlTemplate>
 <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate>
     <Border BorderBrush="{DynamicResource Focus}" BorderThickness="2" Margin="-4" CornerRadius="3" />
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="Window">
  <Setter Property="Background" Value="{DynamicResource Canvas}" />
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="FontFamily" Value="Segoe UI" />
  <Setter Property="Icon" Value="pack://application:,,,/SongSense;component/Assets/SongSense.ico" />
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="TextWrapping" Value="Wrap" />
  <Setter Property="FontSize" Value="{DynamicResource UiInstructionFont}" />
 </Style>
 <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
  <Style.Triggers>
   <Trigger Property="Text" Value="">
    <Setter Property="Visibility" Value="Collapsed" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="Padding" Value="16,10" />
  <Setter Property="FontSize" Value="{DynamicResource UiControlFont}" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationAdornment}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid>
      <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
         <ContentPresenter.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ContentPresenter.Resources>
        </ContentPresenter>
        <TextBlock Grid.Row="1" x:Name="BusyMark" Text="En curso…" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource UiInstructionFont}" />
       </Grid>
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="10" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter Property="Background" Value="{DynamicResource HoverSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter Property="Background" Value="{DynamicResource PressedSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
       <Setter TargetName="Body" Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="local:UiState.IsBusy" Value="True">
       <Setter TargetName="BusyMark" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Validation.HasError" Value="True">
       <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Error}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="Body" Property="Background" Value="{DynamicResource DisabledSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
       <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  <Setter Property="Background" Value="{DynamicResource Gold}" />
  <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Style.Triggers>
   <MultiTrigger>
    <MultiTrigger.Conditions>
     <Condition Property="IsEnabled" Value="True" />
     <Condition Property="IsMouseOver" Value="True" />
    </MultiTrigger.Conditions>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Background" Value="{DynamicResource Gold}" />
   </MultiTrigger>
   <MultiTrigger>
    <MultiTrigger.Conditions>
     <Condition Property="IsEnabled" Value="True" />
     <Condition Property="IsPressed" Value="True" />
    </MultiTrigger.Conditions>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Background" Value="{DynamicResource Gold}" />
   </MultiTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Canvas}" />
  <Setter Property="Padding" Value="12,8" />
 </Style>
 <Style TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="FontSize" Value="{DynamicResource UiControlFont}"/>
  <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledText}"/></Trigger></Style.Triggers>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  <Setter Property="FontSize" Value="{DynamicResource UiControlFont}" />
  <Setter Property="Padding" Value="4" />
  <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationAdornment}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="CheckBox">
     <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="24" />
       <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Box" Width="20" Height="20" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" VerticalAlignment="Top" />
      <Path x:Name="Tick" Width="14" Height="12" Data="M 1,6 L 5,10 L 13,1" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.5" Stretch="Fill" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,4,0,0" />
      <Border x:Name="Mixed" Width="10" Height="3" Background="{DynamicResource OnAccent}" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,8,0,0" />
      <ContentPresenter Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center">
       <ContentPresenter.Resources><DataTemplate DataType="{x:Type sys:String}"><AccessText Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ContentPresenter.Resources>
      </ContentPresenter>
      <Border x:Name="CheckFocus" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="4" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False" />
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Focus}" />
       <Setter TargetName="Box" Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Box" Property="BorderThickness" Value="3" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Box" Property="Background" Value="{DynamicResource Gold}" />
       <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}">
       <Setter TargetName="Box" Property="Background" Value="{DynamicResource Gold}" />
       <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="CheckFocus" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Validation.HasError" Value="True">
       <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Error}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
       <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DisabledText}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="InputBase" TargetType="Control">
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="Padding" Value="12" />
  <Setter Property="FontSize" Value="{DynamicResource UiControlFont}" />
  <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationAdornment}" />
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
   </Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
    <Setter Property="BorderThickness" Value="2" />
   </Trigger>
   <Trigger Property="Validation.HasError" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
    <Setter Property="BorderThickness" Value="2" />
   </Trigger>
   <Trigger Property="IsEnabled" Value="False">
    <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
    <Setter Property="Background" Value="{DynamicResource DisabledSurface}" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <ControlTemplate x:Key="InputTemplate" TargetType="Control">
  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
   <ScrollViewer x:Name="PART_ContentHost" />
  </Border>
 </ControlTemplate>
 <Style TargetType="TextBox" BasedOn="{StaticResource InputBase}">
  <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
  <Setter Property="SelectionBrush" Value="{DynamicResource Gold}" />
  <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccent}" />
  <Setter Property="SelectionOpacity" Value="1" />
  <Setter Property="Template" Value="{StaticResource InputTemplate}" />
 </Style>
 <Style TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
  <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
  <Setter Property="SelectionBrush" Value="{DynamicResource Gold}" />
  <Setter Property="SelectionTextBrush" Value="{DynamicResource OnAccent}" />
  <Setter Property="SelectionOpacity" Value="1" />
  <Setter Property="Template" Value="{StaticResource InputTemplate}" />
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource InputBase}">
  <Setter Property="Padding" Value="10,8" />
  <Setter Property="MinHeight" Value="38" />
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
       <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
         <Border Background="Transparent">
          <Path Data="M 0,0 L 8,0 L 4,4 Z" Fill="{DynamicResource Ink}" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" />
         </Border>
        </ControlTemplate>
       </ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Margin="10,6,32,6" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
       <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="4">
        <ScrollViewer MaxHeight="280" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="SelectableItem" TargetType="ContentControl">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Background" Value="{DynamicResource Surface}" />
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Padding" Value="10,8" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContentControl">
     <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2">
      <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
       <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SelectableItem}">
  <Style.Triggers>
   <Trigger Property="IsHighlighted" Value="True">
    <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
   </Trigger>
   <Trigger Property="IsSelected" Value="True">
    <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="ListBox" BasedOn="{StaticResource InputBase}">
  <Setter Property="Padding" Value="2" />
  <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ListBox">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
      <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
       <ItemsPresenter />
      </ScrollViewer>
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableItem}">
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True">
    <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="{DynamicResource Gold}" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="TabControl">
  <Setter Property="Background" Value="{DynamicResource Canvas}" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="Padding" Value="0" />
 </Style>
 <Style TargetType="TabItem">
  <Setter Property="Padding" Value="18,12" />
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="FontSize" Value="{DynamicResource UiControlFont}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Margin="0,0,8,12" Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectionSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
       <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Gold}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
       <Setter TargetName="TabBorder" Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="ToggleBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="2,4">
      <DockPanel>
       <TextBlock x:Name="Arrow" DockPanel.Dock="Left" Text="›" FontSize="{DynamicResource UiHeading18}" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}" />
       <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
      </DockPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Arrow" Property="Text" Value="⌄" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Focus}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SelectionSurface}" />
       <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="Expander">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="FontSize" Value="{DynamicResource UiInstructionFont}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Expander">
     <StackPanel>
      <ToggleButton Style="{StaticResource ExpanderToggle}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" />
      <ContentPresenter x:Name="ContentSite" Visibility="Collapsed" />
     </StackPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsExpanded" Value="True">
       <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate>
     <Border Background="Transparent" />
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ScrollThumb" TargetType="Thumb">
  <Setter Property="Background" Value="{DynamicResource ControlBorder}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="4" Margin="2" />
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Focus}" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
       <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource Gold}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="14" />
  <Setter Property="MinWidth" Value="0" />
  <Setter Property="Background" Value="{DynamicResource Canvas}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Grid Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton>
        <RepeatButton x:Name="PageBefore" Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" />
       </Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb x:Name="ScrollGrip" Style="{StaticResource ScrollThumb}" MinHeight="24" />
       </Track.Thumb>
       <Track.IncreaseRepeatButton>
        <RepeatButton x:Name="PageAfter" Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" />
       </Track.IncreaseRepeatButton>
      </Track>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
       <Setter Property="Width" Value="Auto" />
       <Setter Property="Height" Value="14" />
       <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
       <Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand" />
       <Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand" />
       <Setter TargetName="ScrollGrip" Property="MinHeight" Value="0" />
       <Setter TargetName="ScrollGrip" Property="MinWidth" Value="24" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Visibility" Value="Hidden" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="Height" Value="14" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="SliderThumb" TargetType="Thumb">
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border x:Name="SliderThumbBody" Background="{DynamicResource Gold}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Width="18" Height="24" CornerRadius="4" />
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="SliderThumbBody" Property="BorderBrush" Value="{DynamicResource Focus}" />
       <Setter TargetName="SliderThumbBody" Property="BorderThickness" Value="2" />
      </Trigger>
      <Trigger Property="IsDragging" Value="True">
       <Setter TargetName="SliderThumbBody" Property="BorderThickness" Value="3" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="SliderThumbBody" Property="Background" Value="{DynamicResource DisabledText}" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="Slider">
  <Setter Property="MinHeight" Value="32" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid Background="Transparent" Margin="4">
      <Border Height="4" Background="{DynamicResource ControlBorder}" VerticalAlignment="Center" />
      <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
       <Track.DecreaseRepeatButton>
        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ScrollPageButton}" />
       </Track.DecreaseRepeatButton>
       <Track.Thumb>
        <Thumb Style="{StaticResource SliderThumb}" />
       </Track.Thumb>
       <Track.IncreaseRepeatButton>
        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollPageButton}" />
       </Track.IncreaseRepeatButton>
      </Track>
      <Border x:Name="SliderFocus" BorderBrush="{DynamicResource Focus}" BorderThickness="2" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False" />
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="SliderFocus" Property="Visibility" Value="Visible" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ContextMenu">
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ContextMenu">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="4">
      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
     </Border>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Background" Value="{DynamicResource Raised}" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="BorderThickness" Value="2" />
  <Setter Property="Padding" Value="10,8" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="MenuItem">
     <Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="20" />
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" VerticalAlignment="Center" />
        <Path x:Name="MenuCheck" Data="M 1,6 L 5,10 L 13,1" Width="13" Height="11" Stretch="Fill" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Visibility="Collapsed" VerticalAlignment="Center" />
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource UiInstructionFont}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <Path x:Name="SubmenuArrow" Grid.Column="3" Data="M 0,0 L 4,4 L 0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" Width="4" Height="8" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right" />
       </Grid>
      </Border>
      <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
       <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="4" CornerRadius="6">
        <ScrollViewer CanContentScroll="True" MaxHeight="400" VerticalScrollBarVisibility="Auto">
         <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
        </ScrollViewer>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="HasItems" Value="True">
       <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed" />
       <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="Role" Value="TopLevelHeader">
       <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="IsHighlighted" Value="True">
    <Setter Property="Background" Value="{DynamicResource SelectionSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource SelectionInk}" />
   </Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="BorderBrush" Value="{DynamicResource Focus}" />
   </Trigger>
   <Trigger Property="IsEnabled" Value="False">
    <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate>
     <Border Height="1" Background="{DynamicResource Outline}" Margin="8,6" />
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="local:StatusNotice">
  <Setter Property="Foreground" Value="{DynamicResource Information}" />
  <Setter Property="Focusable" Value="False" />
  <Setter Property="FontSize" Value="{DynamicResource UiInstructionFont}" />
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="local:StatusNotice">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Symbol" Text="ⓘ" FontFamily="Segoe UI Symbol" FontSize="{DynamicResource UiHeading18}" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" />
      <StackPanel Grid.Column="1">
       <TextBlock x:Name="NoticeText" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding DisplayText}" TextWrapping="Wrap" TextTrimming="None"/>
       <Expander x:Name="NoticeDetail" Header="Ver detalle" FontSize="{DynamicResource UiInstructionFont}" Visibility="Collapsed">
        <TextBox Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Detalle completo del aviso"/>
       </Expander>
      </StackPanel>
     </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="HasDetails" Value="True"><Setter TargetName="NoticeDetail" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="Kind" Value="Success">
       <Setter Property="Foreground" Value="{DynamicResource Success}" />
       <Setter TargetName="Symbol" Property="Text" Value="✓" />
      </Trigger>
      <Trigger Property="Kind" Value="Warning">
       <Setter Property="Foreground" Value="{DynamicResource Warning}" />
       <Setter TargetName="Symbol" Property="Text" Value="⚠" />
      </Trigger>
      <Trigger Property="Kind" Value="Error">
       <Setter Property="Foreground" Value="{DynamicResource Error}" />
       <Setter TargetName="Symbol" Property="Text" Value="⊗" />
      </Trigger>
      <Trigger Property="Kind" Value="Progress">
       <Setter Property="Foreground" Value="{DynamicResource Progress}" />
       <Setter TargetName="Symbol" Property="Text" Value="◷" />
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
  <Style.Triggers>
   <Trigger Property="Message" Value="">
    <Setter Property="Visibility" Value="Collapsed" />
   </Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
