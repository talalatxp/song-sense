<Window x:Class="SongSense.App.ConnectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cuenta y consumo · Song Sense" Width="640" Height="800" MinWidth="360" MinHeight="480" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" Icon="pack://application:,,,/SongSense;component/Assets/SongSense.ico">
 <Window.Resources>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{StaticResource Raised}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource Raised}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="6"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Gold}" Margin="8"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" Margin="10,6,30,6" VerticalAlignment="Center"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Gold}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Padding" Value="10,8"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24">
   <TextBlock Text="Cuenta y consumo" FontFamily="Georgia" FontSize="28" Foreground="{StaticResource Gold}"/>
   <TextBlock Text="{Binding Status}" Foreground="{StaticResource Gold}" Margin="0,12,0,16"/>
   <StackPanel IsEnabled="{Binding CanManage}">
    <TextBlock Text="Elige cómo usar IA" FontWeight="SemiBold"/>
    <WrapPanel Margin="0,8,0,16">
     <Button Content="Usar ChatGPT · solo uso incluido" Click="UseChatGpt" Margin="0,0,8,8"/>
     <Button Content="Elegir API key · de pago" Click="UseApiKey" Margin="0,0,0,8"/>
    </WrapPanel>
    <Border Background="{StaticResource Surface}" Padding="16" CornerRadius="8">
     <StackPanel>
      <TextBlock Text="ChatGPT · solo uso incluido" Foreground="{StaticResource Gold}" FontSize="17"/>
      <TextBlock Text="{Binding Account}" Margin="0,10,0,10" AutomationProperties.Name="Cuenta ChatGPT seleccionada"/>
      <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Label" SelectedValuePath="ClientId" SelectedValue="{Binding SelectedClientId}" AutomationProperties.Name="Cuentas ChatGPT" Margin="0,0,0,10"/>
      <WrapPanel>
       <Button Content="Usar cuenta seleccionada" Click="SelectAccount" Margin="0,0,8,8"/>
       <Button Content="Continuar con ChatGPT" Click="Connect" Margin="0,0,8,8"/>
       <Button Content="Añadir otra cuenta" Click="AddAccount" IsEnabled="{Binding CanAddAccount}" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock Text="Acceso oficial en tu navegador. Elige la cuenta que utilizas en Codex y comprueba aquí su correo. Song Sense no importa sesiones ni contraseñas de Codex. Los permisos no dan acceso a tus conversaciones de ChatGPT. Los tokens se cifran para tu usuario de Windows, fuera de Git y de SQLite." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,16"/>
      <WrapPanel>
       <Button Content="Consultar modelos" Click="LoadModels" IsEnabled="{Binding CanLoadModels}" Margin="0,0,8,8"/>
       <Button Content="Desconectar cuenta" Click="Disconnect" IsEnabled="{Binding CanDisconnect}" Margin="0,0,0,8"/>
      </WrapPanel>
      <ComboBox ItemsSource="{Binding Models}" DisplayMemberPath="DisplayName" SelectedValuePath="Slug" SelectedValue="{Binding SelectedModel}" AutomationProperties.Name="Modelo autorizado por ChatGPT" Margin="0,4,0,10"/>
      <Button Content="Guardar modelo seleccionado" Click="SelectModel" HorizontalAlignment="Left"/>
     </StackPanel>
    </Border>
    <Border Background="{StaticResource Surface}" Padding="16" CornerRadius="8" Margin="0,16,0,16">
     <StackPanel>
      <TextBlock Text="Consultas bloqueadas para evitar cargos extra" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/>
      <TextBlock Text="En ChatGPT → Uso, desactiva Permitir que otras apps usen créditos tras alcanzar el límite. Esa configuración afecta a todas las apps. Song Sense no dispone de un mecanismo oficial documentado para verificarla: por eso no envía consultas con el plan, aunque conectes tu cuenta o selecciones un modelo. No hay cambios automáticos a API key ni compra de créditos." FontSize="13" Margin="0,8,0,12"/>
      <Button Content="Gestionar uso en ChatGPT" Click="ManageUsage" HorizontalAlignment="Left"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Tokens por consulta" Foreground="{StaticResource Gold}" FontSize="17"/>
    <TextBlock Text="Cada análisis de IA muestra los tokens de entrada, salida y total comunicados por OpenAI. Si no los comunica, aparece Consumo no comunicado. Una lectura de caché utiliza 0 tokens nuevos. No se convierten tokens en porcentajes del plan: los límites se comparten con Codex y otras apps y se consultan en Gestionar uso." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,16"/>
    <Button Content="Ajustes de API key · de pago" Click="OpenApiSettings" IsEnabled="{Binding IsApiMode}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
   </StackPanel>
   <Button Content="Cancelar operación" Click="CancelOperation" IsEnabled="{Binding CanCancel}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding Message}" Foreground="{StaticResource Gold}"/>
  </StackPanel>
 </ScrollViewer>
</Window>
